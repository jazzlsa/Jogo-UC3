# Copie para tools/.env e preencha. Esse arquivo (.env) nunca deve ser
# commitado — já está no .gitignore da raiz do repo.

# Chave da API do Gemini (https://aistudio.google.com/apikey). Só é usada
# por tools/generate_case.py, na sua máquina — nunca vai pro jogo empacotado.
GEMINI_API_KEY=

# Caminho para o JSON da service account do Google (mesmo tipo de credencial
# usada em med_study_automator/config/credentials.json — pode apontar pro
# mesmo arquivo, ou copiar pra tools/config/credentials.json).
GOOGLE_CREDENTIALS_PATH=tools/config/credentials.json

# ID da planilha (parte da URL entre /d/ e /edit) que tem a aba "uc3" com os
# links dos notebooks do NotebookLM.
GOOGLE_SPREADSHEET_ID=1H2lDCWgw2L-Df70vUU7OQTs2IIpdfo8fipim2fKth60
